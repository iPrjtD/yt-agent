# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose service "db") ---
POSTGRES_USER=ytagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ytagent
DATABASE_URL=postgresql+psycopg://ytagent:change-me@127.0.0.1:5432/ytagent

# --- Local services ---
OLLAMA_API_BASE=http://127.0.0.1:11434
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_SECRET=generate-a-long-random-string
# Full path to ffmpeg.exe if it is not on PATH
FFMPEG_BINARY=ffmpeg

# --- YouTube (Google Cloud project) ---
# API key: public read-only calls (trending charts, search).
YOUTUBE_API_KEY=
# OAuth desktop client JSON: uploads, playlists, analytics. Keep the file in secrets/.
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json

# --- Stock media (free accounts) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Google Gemini API (free tier, https://aistudio.google.com/apikey) for script writing ---
GEMINI_API_KEY=

# --- Optional notifications (ntfy.sh topic, keep it hard to guess) ---
NTFY_TOPIC=
